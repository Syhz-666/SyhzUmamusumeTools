{
  "name": "syhz-umamusume-tools",
  "version": "1.0.2",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build && electron .",
    "check": "tsc -p app/tsconfig.json",
    "build": "npm run check && vite build --config app/vite.config.mts app",
    "test": "node --test tests/*.test.mjs",
    "test:persistence": "node scripts/test-persistence.cjs",
    "smoke": "electron . --smoke-test",
    "pack": "npm run build && electron-builder --win nsis --x64",
    "format": "prettier --write main.cjs preload.cjs store.cjs app/src app/index.html app/vite.config.mts app/tsconfig.json tests README.md DATA-SOURCES.md package.json"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.syhz.umamusumetools",
    "productName": "SyhzUmamusumeTools",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "store.cjs",
      "persistence.cjs",
      "app/dist/**/*",
      "app/src/engine.mjs",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "SyhzUmamusumeTools-${version}-x64-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "国服优俊少女奖杯收藏与三年赛事预约助手",
  "author": "SyhzUmamusumeTools",
  "private": true
}
